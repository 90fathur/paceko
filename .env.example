# ========================================================
# ENVIRONMENT CONFIGURATION FOR PACEKO.COM (CodeIgniter 4)
# ========================================================
# Salin file ini menjadi .env di hosting server Anda
# Ubah nilai di bawah sesuai dengan domain dan database hosting

# Mode: production (untuk live server) atau development (untuk testing)
CI_ENVIRONMENT = production

# URL Website Hosting
app.baseURL = 'https://paceko.com/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = false
app.appTimezone = 'Asia/Makassar'

# Pengaturan Database Hosting (cPanel / MySQL)
database.default.hostname = localhost
database.default.database = nama_database_cpanel
database.default.username = user_database_cpanel
database.default.password = password_database_cpanel
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Log level
logger.threshold = 4
