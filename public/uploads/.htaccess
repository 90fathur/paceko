# ----------------------------------------------------------------------
# BSSN & OWASP File Upload Security Hardening
# PACEKO.com - CodeIgniter 4
# ----------------------------------------------------------------------

# 1. Disable execution of scripts and executable binaries
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|phar|inc|cgi|pl|py|sh|bash|exe|dll|jsp|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Disable PHP Engine in upload directories (Apache & LiteSpeed)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 3. Prevent CGI execution and Directory Indexing
Options -ExecCGI -Indexes

# 4. Enforce proper MIME-sniffing protection for all static assets
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
